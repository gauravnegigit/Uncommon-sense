{
  "triage_categories": {
    "RED": {
      "level": "IMMEDIATE_EMERGENCY",
      "action": "Dispatch emergency ambulance immediately. Direct transfer to District Hospital / Trauma Centre.",
      "time_to_care": "Immediate (<10 mins)"
    },
    "YELLOW": {
      "level": "URGENT_REFERRAL",
      "action": "Refer to nearest Primary Health Centre (PHC) or Community Health Centre (CHC) for evaluation within 2 to 4 hours.",
      "time_to_care": "Same day"
    },
    "GREEN": {
      "level": "ROUTINE_CARE",
      "action": "Provide home care guidance, WHO/ICMR home remedies, and schedule visit with local ASHA worker/PHC during regular hours.",
      "time_to_care": "24 to 48 hours"
    }
  },
  "rules": [
    {
      "id": "CRIT_001",
      "category": "RED",
      "symptom": "Severe Respiratory Distress",
      "keywords": [
        "cannot speak in full sentences",
        "gasping for air",
        "blue lips",
        "stridor",
        "severe breathlessness at rest"
      ],
      "exclusion_keywords": ["mild cough", "stuffy nose", "breathless only on heavy exertion"],
      "recommended_facility": "District Hospital (Respiratory/ICU Unit)"
    },
    {
      "id": "CRIT_002",
      "category": "RED",
      "symptom": "Acute Coronary / Cardiovascular Threat",
      "keywords": [
        "crushing chest pain",
        "chest pressure radiating to left arm",
        "chest pain with cold sweating",
        "sudden fainting with chest heaviness"
      ],
      "exclusion_keywords": ["chest pain when pressing on rib", "acid reflux", "stomach gas"],
      "recommended_facility": "District Hospital (Cardiology/ICU)"
    },
    {
      "id": "CRIT_003",
      "category": "RED",
      "symptom": "Altered Mental Status / Neurological Deficit",
      "keywords": [
        "unconscious",
        "unresponsive",
        "active seizure",
        "fits",
        "sudden face drooping",
        "sudden inability to move one side of body"
      ],
      "exclusion_keywords": ["mild headache", "feeling sleepy due to fever"],
      "recommended_facility": "District Hospital (Neurology/Emergency)"
    },
    {
      "id": "CRIT_004",
      "category": "RED",
      "symptom": "Severe Hemorrhage / Active Shock",
      "keywords": [
        "uncontrolled spurting blood",
        "vomiting large amounts of blood",
        "coughing up blood in large quantities",
        "cold clammy skin with rapid pulse"
      ],
      "exclusion_keywords": ["small cut on finger", "minor nosebleed that stopped"],
      "recommended_facility": "Trauma Centre / CHC with Blood Bank"
    },
    {
      "id": "URG_001",
      "category": "YELLOW",
      "symptom": "High Fever with Localizing Warning Signs",
      "keywords": [
        "fever",
        "fever with severe shivering and stiff neck",
        "fever with dark urine and yellow eyes",
        "fever with persistent vomiting"
      ],
      "exclusion_keywords": [],
      "recommended_facility": "Primary Health Centre (PHC) / CHC"
    },
    {
      "id": "URG_002",
      "category": "YELLOW",
      "symptom": "Moderate Dehydration / Acute Diarrhea",
      "keywords": [
        "loose motions",
        "sunken eyes with extreme thirst",
        "unable to keep fluids down"
      ],
      "exclusion_keywords": [],
      "recommended_facility": "Primary Health Centre (PHC) for ORS/IV Fluid protocol"
    },
    {
      "id": "ROUT_001",
      "category": "GREEN",
      "symptom": "Mild Upper Respiratory Infection",
      "keywords": [
        "mild fever",
        "runny nose",
        "sore throat without difficulty swallowing",
        "mild body ache"
      ],
      "exclusion_keywords": [],
      "recommended_facility": "Sub-Centre / Local ASHA Worker"
    }
  ]
}