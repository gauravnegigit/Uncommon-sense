ENV=development

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=jancare

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# FHIR export base URL (used for identifier systems and Bundle fullUrls)
FHIR_BASE_URL=https://jancare.local/fhir

# OTP delivery (leave blank in development: OTPs are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_API_KEY=
